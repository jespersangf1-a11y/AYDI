# AYDI — Beispielkonfiguration
#
# Kopieren nach `.env` (Repo-Wurzel) bzw. `backend/.env`, je nachdem, aus welchem
# Verzeichnis du startest: `app/core/config.py` liest `.env` RELATIV ZUM
# ARBEITSVERZEICHNIS. Docker Compose liest die Datei in der Repo-Wurzel.
#
# Hier stehen ALLE 18 Einstellungen aus `backend/app/core/config.py::Settings`.
# Jede ist optional — ohne .env laeuft die App mit den unten genannten Defaults
# gegen eine lokale SQLite-Datei. Fuer die Produktion siehe den Abschnitt unten.
#
# ACHTUNG: `.env` und `.env.*` sind per .gitignore ausgeschlossen. Trag hier
# niemals echte Schluessel ein — diese Datei IST versioniert.

# ─── Betriebsmodus ──────────────────────────────────────────────────────────
# development | production
# `production` schaltet den Boot-Guard scharf: Die App verweigert dann den Start,
# solange SECRET_KEY der Default ist oder COOKIE_SECURE nicht gesetzt ist.
ENVIRONMENT=development

# ─── Datenbank ──────────────────────────────────────────────────────────────
# Default ohne .env: sqlite+aiosqlite:///./aydi.db
# Produktion/Compose: postgresql+asyncpg://USER:PASS@HOST:5432/DB
DATABASE_URL=postgresql+asyncpg://aydi:aydi@db:5432/aydi
DATABASE_POOL_SIZE=10

# Nur fuer docker-compose (Postgres-Container), nicht von Settings gelesen:
POSTGRES_DB=aydi
POSTGRES_USER=aydi
POSTGRES_PASSWORD=aydi

# ─── Sicherheit ─────────────────────────────────────────────────────────────
# SECRET_KEY signiert die JWTs. Der eingebaute Default steht oeffentlich im
# Repo — mit ihm lassen sich Tokens inklusive Admin-Rolle faelschen.
# Eigenen Wert erzeugen:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=aydi-secret-key-change-in-production

# true = Cookies nur ueber HTTPS. In Produktion Pflicht (Boot-Guard).
COOKIE_SECURE=false
# true = nur Cookie-Auth, der Bearer-Header-Fallback wird abgeschaltet.
AUTH_COOKIE_ONLY=false
# Cookie-Domain, z.B. .aydi.example. Leer lassen fuer host-only.
COOKIE_DOMAIN=
# Nur auf true setzen, wenn ein VERTRAUENSWUERDIGER Proxy davorsteht: Sonst
# kann jeder Client seine IP faelschen und damit das Rate-Limit umgehen.
TRUST_PROXY_HEADERS=false

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ───────────────────────────────────────────────────────────────────
# JSON-Array. Mit Cookie-Auth darf hier NICHT ["*"] stehen.
CORS_ORIGINS=["http://localhost:5173","http://localhost"]

# ─── Claude Vision (Pipeline B) ─────────────────────────────────────────────
# Ohne Key laeuft die App, die visuelle Analyse meldet aber "nicht beurteilbar".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
VISUAL_ANALYSIS_TIMEOUT_SEC=30

# ─── Uploads ────────────────────────────────────────────────────────────────
# UPLOAD_DIR ist relativ zum Arbeitsverzeichnis. Im Container auf ein
# persistentes Volume legen — sonst sind Bilder nach einem Neustart weg.
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=20

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# true = strukturierte JSON-Logs (fuer Produktion empfohlen).
LOG_JSON=false

# ─── Produktions-Checkliste ─────────────────────────────────────────────────
# ENVIRONMENT=production
# SECRET_KEY=<eigener Zufallswert>
# COOKIE_SECURE=true
# DATABASE_URL=postgresql+asyncpg://...
# CORS_ORIGINS=["https://deine-domain"]
# LOG_JSON=true
# Fehlt SECRET_KEY oder COOKIE_SECURE, startet die App bewusst NICHT.
