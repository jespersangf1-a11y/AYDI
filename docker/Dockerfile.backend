FROM python:3.12-slim

WORKDIR /app/backend

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

# --no-server-header: ohne diesen Schalter schreibt uvicorn "Server: uvicorn"
# vor die Kopfzeilen der Anwendung, und die Middleware kann ihn nicht mehr
# ersetzen, sondern nur doppeln. Die Serversoftware soll nicht im Klartext
# nach aussen gehen.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-server-header"]
